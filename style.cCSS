/* ==========================================
   ۱. تنظیمات پایه و متغیرهای رنگی پروژه
   ========================================== */
:root {
  --bg-cream: #f4eee0;       /* رنگ پس‌زمینه اصلی کرم روشن */
  --navy-blue: #0b1e36;      /* رنگ سرمه‌ای برای عناوین و متن‌ها */
  --orange-gold: #ff7a00;    /* رنگ نارنجی/طلایی لوگو و حاشیه‌ها */
  --black-card: #121212;     /* رنگ مشکی برای پس‌زمینه لوگو */
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background-color: var(--bg-cream);
  color: #1a1a1a;
  font-family: system-ui, -apple-system, sans-serif;
  direction: rtl;
  min-height: 100vh;
}

/* ==========================================
   ۲. استایل هدر و بنر اصلی (طرح مطابق عکس)
   ========================================== */
.main-header {
  background-color: var(--bg-cream);
  padding: 2.5rem 1rem;
  border-bottom: 1px solid #e0d6c3;
  display: flex;
  justify-content: center;
  align-items: center;
}

.header-container {
  max-width: 1200px;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2.5rem;
}

/* ==========================================
   ۳. تنظیمات لوگوی دایره‌ای مشکی و بزرگ
   ========================================== */
.logo-box {
  width: 150px;
  height: 150px;
  border-radius: 50%;
  overflow: hidden;
  background-color: var(--black-card);
  border: 3px solid var(--orange-gold);
  box-shadow: 0 0 25px rgba(255, 122, 0, 0.4), 0 8px 20px rgba(0, 0, 0, 0.3);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-box img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

/* ==========================================
   ۴. جایگاه تصویر متن خطاطی اختصاصی
   ========================================== */
.brand-title-img {
  max-width: 480px;
  width: 100%;
  height: auto;
  display: block;
}

/* ==========================================
   ۵. بخش بدنه اصلی برای ماژول‌های بعدی
   ========================================== */
.main-container {
  max-width: 1200px;
  margin: 2rem auto;
  padding: 0 1rem;
}

/* ==========================================
   ۶. واکنش‌گرایی برای صفحات کوچک و موبایل
   ========================================== */
@media (max-width: 768px) {
  .main-header {
    padding: 1.5rem 1rem;
  }
  
  .header-container {
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .logo-box {
    width: 120px;
    height: 120px;
  }
  
  .brand-title-img {
    max-width: 320px;
  }
}

